  "liveNow": false,
  "panels": [
    {
      "title": "Energy Consumption Trend",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"default\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"energy_reading\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> group(columns: [\"node_id\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 15 },
          "unit": "watt",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      }
    },
    {
      "title": "Cumulative Energy (24h)",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"default\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"energy_reading\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> group()\n  |> sum()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watth",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "title": "Predictive Alerts",
      "type": "table",
      "datasource": { "type": "influxdb", "uid": "" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"default\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"predictive_alert\")\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Fault Frequency (7-day rolling)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"default\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"fault_event\")\n  |> group(columns: [\"node_id\"])\n  |> aggregateWindow(every: 1d, fn: count, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      }
    },
    {
      "title": "Degradation Score (per node)",
      "type": "gauge",
      "datasource": { "type": "influxdb", "uid": "" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"default\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"predictive_alert\")\n  |> filter(fn: (r) => r._field == \"degradation_score\")\n  |> last()\n  |> group(columns: [\"node_id\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      }
    }
  ],
