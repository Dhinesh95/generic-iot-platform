  "panels": [
    {
      "title": "Active Actuators",
      "type": "stat",
      "datasource": { "type": "influxdb", "uid": "" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"default\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"actuator_state\")\n  |> distinct(column: \"node_id\")\n  |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "title": "Actuator State Overview",
      "type": "table",
      "datasource": { "type": "influxdb", "uid": "" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"default\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"actuator_state\")\n  |> last()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"node_id\", \"metric_id\"], valueColumn: \"_value\")"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" }, "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ]}
        },
        "overrides": []
      }
    },
    {
      "title": "Actuator Command History",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"default\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"actuator_state\")\n  |> group(columns: [\"node_id\", \"metric_id\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 20 },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      }
    },
    {
      "title": "Actuator Response Time (ms)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"default\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"actuator_state\")\n  |> filter(fn: (r) => r._field == \"response_time_ms\")\n  |> group(columns: [\"node_id\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "unit": "ms",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      }
    },
    {
      "title": "Failsafe Events",
      "type": "table",
      "datasource": { "type": "influxdb", "uid": "" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"default\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => r._measurement == \"actuator_state\")\n  |> filter(fn: (r) => r._field == \"failsafe_triggered\")\n  |> filter(fn: (r) => r._value == 1.0)\n  |> group()"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } },
        "overrides": []
      }
    }
  ],
